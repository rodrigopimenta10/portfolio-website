{
  "hosting": {
    "target": "portfolio",
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      { "source": "/resume", "destination": "/rodrigo_pimenta_resume.pdf", "type": 302 },
      { "source": "/experience", "destination": "/rodrigo_pimenta_resume.pdf", "type": 302 },
      { "source": "/projects/ceph-storage-self-healing-monitor", "destination": "/self-healing/storage", "type": 301 },
      { "source": "/projects/config-integrity-self-heal", "destination": "/self-healing/config-drift", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "portfolio-status",
          "region": "us-east4"
        }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
          { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
        ]
      },
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
      },
      {
        "source": "/@(on-call|tools|self-healing|projects|how-this-site-runs|404.html)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
      },
      {
        "source": "/@(projects|self-healing)/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
      },
      {
        "source": "/_astro/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/rodrigo_pimenta_resume.pdf",
        "headers": [
          { "key": "Content-Type", "value": "application/pdf" },
          { "key": "Content-Disposition", "value": "inline; filename=\"rodrigo_pimenta_resume.pdf\"" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      }
    ]
  }
}
