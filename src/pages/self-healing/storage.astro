---
// The storage monitor in detail: the rules that let it act without a person, what an engineer used
// to do by hand, and what I took from building it. The simulation of it is on the Self-healing tab.
import Onward from '../../components/Onward.astro';
import Base from '../../layouts/Base.astro';

const lede =
  'When the storage behind a gateway’s servers stalled, about 40,000 to 60,000 customers lost their internet, about every two weeks. A monitor now catches it on a 3-minute check and fixes it before an outage.';

const rules = [
  {
    title: 'It looks on a fixed cycle, not when someone is called.',
    text: 'Every three minutes it reads the state of every cluster again.',
  },
  {
    title: 'It checks where the work is going before it moves it.',
    text: 'A failover onto a standby with no room turns one problem into two. The monitor assesses the standby first and reaches one of four verdicts, and only some of them allow the move.',
  },
  {
    title: 'It does not take the command’s word for it.',
    text: 'After a failover it reads the cluster’s own log to see what happened, because the same node taking the work straight back can look like a success and is not one.',
  },
  {
    title: 'It writes down what it does.',
    text: 'Events are appended to a history that is never rewritten, with a dashboard beside it.',
  },
];

const byHand = [
  'Log in to the imaging server of the affected SNC rack (the rack of servers at the gateway).',
  'From there, log in to one of its three Ceph storage nodes: two active, one idle.',
  'Run health commands to find which node is unhealthy.',
  'Run one command, ‘mds fail’ with that node’s name, to move its work to a healthy node.',
];

const taken = [
  'Automation that acts by itself needs a way to say no, and “no” has to be an outcome it reports, not an error.',
  '“It ran” and “it worked” are different facts and need different evidence.',
  'The number worth quoting is the outage it removed, not how often it acted.',
];

const builtWith = ['Python', 'Fabric/SSH', 'PostgreSQL', 'Grafana', 'pytest'];
---

<Base title="Case study: the storage self-healing monitor" path="/self-healing/storage" description={lede}>
  <div class="wrap">
    <nav class="back" aria-label="Breadcrumb">
      <a href="/self-healing"><span aria-hidden="true">←&nbsp;</span>Self-healing</a>
    </nav>

    <header class="page-head">
      <p class="eyebrow">How it works, in detail · Hughes Network Systems · in production</p>
      <h1>A storage failure took 90 minutes to fix by hand. Now it heals itself, and nobody is called.</h1>
      <p class="lede">{lede}</p>
      <dl class="facts">
        <div class="bad">
          <dt>Before</dt>
          <dd>About an hour and a half of manual recovery by the on-call engineer, at any hour.</dd>
        </div>
        <div class="good">
          <dt>After</dt>
          <dd><strong>Caught on a 3-minute check and fixed before customers lose service, with no human involved.</strong></dd>
        </div>
        <div>
          <dt>Scale</dt>
          <dd>24 storage nodes in 8 clusters.</dd>
        </div>
        <div>
          <dt>Built with</dt>
          <dd>Python, Fabric over SSH, PostgreSQL, Grafana, pytest.</dd>
        </div>
      </dl>
    </header>

    <p class="replay">
      {/* One inner span, so that on a phone the arrow wraps with the words instead of sitting apart. */}
      <a class="go" href="/self-healing#storage">
        <span>Play the simulation of this on the Self-healing tab<span aria-hidden="true">&nbsp;→</span></span>
      </a>
    </p>

    <section class="section" aria-labelledby="how-title">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 id="how-title">Four rules that let it act without a person</h2>
      </div>
      <ol class="rules">
        {
          rules.map((rule, index) => (
            <li>
              <span class="number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{rule.title}</h3>
              <p>{rule.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section before-after" aria-label="Before and after">
      <div>
        <p class="eyebrow">Before</p>
        <h2>What an engineer did by hand</h2>
        <p class="soft">
          The storage is Ceph, an open-source storage system. One of its servers keeps track of every file name and
          folder, and when that server struggles, every client waits. The fix was known, but a person had to do it:
        </p>
        <ol class="steps">
          {byHand.map((step) => <li>{step}</li>)}
        </ol>
        <p class="soft">
          About an hour and a half from the first call to service restored. The monitor now makes the same decision,
          with the same checks, every three minutes.
        </p>
      </div>
      <div>
        <p class="eyebrow">After</p>
        <h2>What I took from building it</h2>
        <ul class="taken">
          {taken.map((line) => <li>{line}</li>)}
        </ul>
        <ul class="chips">
          {builtWith.map((name) => <li class="tag">{name}</li>)}
        </ul>
      </div>
    </section>

    <Onward
      links={[
        {
          label: 'Also in detail',
          text: 'Two racks that disagreed, and the checker that catches it',
          href: '/self-healing/config-drift',
        },
        { label: 'On call', text: 'One 2 AM incident, step by step', href: '/on-call' },
        { label: 'Tools', text: 'The storage check, as one command you can step through', href: '/tools' },
      ]}
    />
  </div>
</Base>

<style>
  .back {
    padding-top: var(--space-4);
  }

  .back a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .back a:hover {
    color: var(--accent);
  }

  /* The way back sits above the heading, so the heading needs less air than on a tab's own page. */
  .page-head {
    padding-top: var(--space-4);
  }

  /* The heading here is two sentences, not a title: it gets a longer line than the shared 20ch. */
  .page-head h1 {
    max-width: 32ch;
  }

  .page-head .facts {
    margin-top: var(--space-2);
  }

  .replay {
    padding-block: var(--space-2);
    border-block: 1px solid var(--rule);
  }

  .rules {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: var(--space-6);
  }

  .rules li {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .rules .number {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
  }

  .rules h3 {
    font-size: 1.125rem;
    line-height: 1.3;
  }

  .rules p {
    color: var(--ink-soft);
  }

  .before-after {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-7) 3.5rem;
  }

  .before-after > div {
    flex: 1 1 23.75rem;
    min-width: 0;
    display: grid;
    gap: var(--space-4);
  }

  /* Each step carries its number in a ring, drawn from the list's own count. */
  .steps {
    display: grid;
    gap: var(--space-3);
    counter-reset: step;
  }

  .steps li {
    display: grid;
    grid-template-columns: 1.625rem 1fr;
    gap: 0.875rem;
    align-items: start;
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    height: 1.625rem;
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }

  .taken {
    border-top: 1px solid var(--rule);
  }

  .taken li {
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--rule);
  }
</style>
