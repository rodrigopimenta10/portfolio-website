---
import { nav } from '../data/site';
import Base from '../layouts/Base.astro';
---

<Base title="Not found" path="/404" noindex description="This page does not exist.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">404 · state: down</p>
      <h1>There is no page at this address</h1>
      <p class="lede">
        Nothing is broken. The link is wrong or the page has moved. The old one-page site was
        replaced, so a link into one of its sections now lands here.
      </p>
    </header>
    <ul class="doors">
      <li><a href="/">Home</a></li>
      {
        nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
      <li><a href="/rodrigo_pimenta_resume.pdf">Resume (PDF)</a></li>
    </ul>
  </div>
</Base>

<style>
  .doors {
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-lg);
  }

  .doors a {
    display: inline-block;
    padding-block: var(--space-1);
  }
</style>
