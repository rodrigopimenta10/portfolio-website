---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { allProjects, isPersonal, isWork, resumeWords } from '../../lib/projects';

const projects = await allProjects();
const personal = projects.filter(isPersonal);
const work = projects.filter(isWork);
---

<Base title="Projects" path="/projects" description="Sightline, aws-platform-terraform and Orbital Watch, with code and live sites to check, and two production systems at Hughes Network Systems.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Projects</p>
      <h1>Three you can open and check. Two that run in production.</h1>
      <p class="lede">
        The first three have public code and, where there is one, a live site. The last two run in
        production at Hughes Network Systems; that code is my employer’s.
      </p>
    </header>

    <ol class="list">
      {
        personal.map((project, index) => (
          <li>
            <article class="item surface">
              <div class="thumb">
                <Image
                  src={project.data.screenshot.src}
                  alt=""
                  widths={[360, 480, 720, 1080, 1440]}
                  sizes="(min-width: 52rem) 22rem, calc(100vw - 2.25rem)"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              </div>
              <div class="text">
                <p class="eyebrow">{String(index + 1).padStart(2, '0')}</p>
                <h2>
                  <a class="stretch" href={`/projects/${project.id}`}>
                    {project.data.title}
                  </a>
                </h2>
                <p class="soft">{project.data.summary}</p>
                <ul class="chips">
                  {project.data.stack.map((item) => <li class="tag">{item}</li>)}
                </ul>
                <p class="doors">
                  <span class="go" aria-hidden="true">
                    Read more <span>→</span>
                  </span>
                  {project.data.live && <a href={project.data.live}>Live site</a>}
                  <a href={project.data.code}>Code</a>
                </p>
              </div>
            </article>
          </li>
        ))
      }
    </ol>

    <section class="section work" aria-labelledby="work-title">
      <div class="section-head">
        <p class="eyebrow">At Hughes Network Systems</p>
        <h2 id="work-title">In production, not public</h2>
      </div>
      <ol class="work-list">
        {
          work.map((project, index) => {
            const words = resumeWords(project);
            return (
              <li>
                <article class="surface">
                  <p class="eyebrow">{String(personal.length + index + 1).padStart(2, '0')}</p>
                  <h3>
                    <a class="stretch" href={`/projects/${project.id}`}>
                      {project.data.title}
                    </a>
                  </h3>
                  <p class="soft">{words.sentences.slice(0, 2).join(' ')}</p>
                  <ul class="chips">
                    {words.stack.map((item) => <li class="tag">{item}</li>)}
                  </ul>
                  <p class="go" aria-hidden="true">
                    Read how it works <span>→</span>
                  </p>
                </article>
              </li>
            );
          })
        }
      </ol>
    </section>
  </div>
</Base>

<style>
  .list {
    display: grid;
    gap: var(--space-5);
    padding-bottom: var(--space-8);
  }

  .item,
  .work-list article {
    position: relative;
    display: grid;
    overflow: hidden;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .item:hover,
  .work-list article:hover {
    transform: translateY(-3px);
    border-color: var(--rule-strong);
    box-shadow: var(--shadow-lift);
  }

  .thumb {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--paper-sunk);
    border-bottom: 1px solid var(--rule);
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform 400ms ease;
  }

  .item:hover .thumb :global(img) {
    transform: scale(1.025);
  }

  .text {
    display: grid;
    gap: var(--space-3);
    align-content: center;
    padding: var(--space-5);
  }

  h2 a,
  h3 a {
    text-decoration: none;
  }

  /* The whole card is the link: the title's link is stretched over it. */
  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .doors {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-5);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .go {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent);
  }

  .go span {
    display: inline-block;
    transition: transform 160ms ease;
  }

  .item:hover .go span,
  .work-list article:hover .go span {
    transform: translateX(4px);
  }

  /* The other links sit above the stretched one, so they still go where they say. */
  .doors a {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--ink-soft);
    text-decoration-color: var(--rule-strong);
  }

  .doors a:hover {
    color: var(--ink);
    text-decoration-color: var(--accent);
  }

  .work-list {
    display: grid;
    gap: var(--space-5);
  }

  .work-list article {
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-6);
  }

  @media (min-width: 52rem) {
    .item {
      grid-template-columns: 24rem minmax(0, 1fr);
    }

    .thumb {
      aspect-ratio: auto;
      min-height: 100%;
      border-bottom: 0;
      border-right: 1px solid var(--rule);
    }

    .text {
      padding: var(--space-6);
    }

    .work-list {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
