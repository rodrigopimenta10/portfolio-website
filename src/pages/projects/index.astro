---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { allProjects, isPersonal, isWork, resumeWords } from '../../lib/projects';

const projects = await allProjects();
const personal = projects.filter(isPersonal);
const work = projects.filter(isWork);
---

<Base title="Projects" path="/projects" description="Sightline, aws-platform-terraform and Orbital Watch, with code and live sites to check, and two production systems at Hughes Network Systems.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Projects</p>
      <h1>Three you can open and check. Two that run in production.</h1>
      <p class="lede">
        The first three have public code and, where there is one, a live site. The last two run in
        production at Hughes Network Systems; that code is my employer’s.
      </p>
    </header>

    <ol class="list">
      {
        personal.map((project, index) => (
          <li>
            <article class="item">
              <a class="thumb frame" href={`/projects/${project.id}`} tabindex="-1" aria-hidden="true">
                <Image
                  src={project.data.screenshot.src}
                  alt=""
                  widths={[360, 480, 720]}
                  sizes="(min-width: 52rem) 22rem, calc(100vw - 2.25rem)"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              </a>
              <div class="text">
                <p class="eyebrow">{String(index + 1).padStart(2, '0')}</p>
                <h2>
                  <a href={`/projects/${project.id}`}>{project.data.title}</a>
                </h2>
                <p>{project.data.summary}</p>
                <p class="mono soft">{project.data.stack.join(' · ')}</p>
                <p class="doors mono">
                  {project.data.live && <a href={project.data.live}>Live site</a>}
                  <a href={project.data.code}>Code</a>
                </p>
              </div>
            </article>
          </li>
        ))
      }
    </ol>

    <section class="section work" aria-labelledby="work-title">
      <div class="section-head">
        <p class="eyebrow">At Hughes Network Systems</p>
        <h2 id="work-title">In production, not public</h2>
      </div>
      <ol class="work-list">
        {
          work.map((project, index) => {
            const words = resumeWords(project);
            return (
              <li>
                <article>
                  <p class="eyebrow">{String(personal.length + index + 1).padStart(2, '0')}</p>
                  <h3>
                    <a href={`/projects/${project.id}`}>{project.data.title}</a>
                  </h3>
                  <p>{words.sentences.slice(0, 2).join(' ')}</p>
                  <p class="mono soft">{words.stack.join(' · ')}</p>
                </article>
              </li>
            );
          })
        }
      </ol>
    </section>
  </div>
</Base>

<style>
  .list {
    display: grid;
    gap: var(--space-7);
    padding-bottom: var(--space-8);
  }

  .item {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--rule);
  }

  .thumb {
    display: block;
    align-self: start;
  }

  .thumb :global(img) {
    width: 100%;
  }

  .text {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  h2 a,
  h3 a {
    text-decoration-color: transparent;
  }

  h2 a:hover,
  h3 a:hover {
    text-decoration-color: var(--accent);
  }

  .doors {
    display: flex;
    gap: var(--space-5);
  }

  .doors a {
    display: inline-block;
    padding-block: var(--space-2);
    font-weight: 500;
  }

  .work-list {
    display: grid;
    gap: var(--space-6);
  }

  .work-list article {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule-strong);
  }

  @media (min-width: 52rem) {
    .item {
      grid-template-columns: 22rem minmax(0, 1fr);
      gap: var(--space-7);
    }

    .work-list {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-7);
    }
  }
</style>
