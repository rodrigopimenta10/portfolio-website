---
// The Side projects tab: the live status panel first, then the three projects as full rows, each
// with its picture, what it is, the one thing to remember about it, and every way in.
import { Image } from 'astro:assets';
import Onward from '../../components/Onward.astro';
import StatusPanel from '../../components/StatusPanel.astro';
import { site } from '../../data/site';
import Base from '../../layouts/Base.astro';
import { allProjects } from '../../lib/projects';

const projects = await allProjects();
---

<Base
  title="Side projects"
  path="/projects"
  description="Three side projects you can open and check: Sightline, Orbital Watch and aws-platform-terraform. Each one is live or public, and a panel checks them as you read."
>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Outside work</p>
      <h1>Three you can open and check</h1>
      <p class="lede">Each one is live or public. The panel below checks them as you read this.</p>
    </header>

    <StatusPanel />

    <ol class="projects">
      {
        projects.map(({ id, data }, index) => (
          <li>
            <article class="project surface">
              <a class="shot" href={data.live ?? data.code}>
                <Image
                  src={data.screenshot.src}
                  alt={data.card.alt}
                  widths={[360, 480, 720, 1080, 1440]}
                  sizes="(min-width: 52rem) 36rem, calc(100vw - 2.25rem)"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              </a>
              <div class="text">
                <header class="top">
                  <span class="number mono">{String(index + 1).padStart(2, '0')}</span>
                  <h2>{data.title}</h2>
                  {data.live ? <span class="kind live mono">live</span> : <span class="kind mono">public code</span>}
                </header>
                <p class="soft">{data.card.summary}</p>
                <p class="proof">
                  <strong>{data.card.claim}</strong> {data.card.detail}
                </p>
                <ul class="chips">
                  {data.card.tags.map((tag) => <li class="tag">{tag}</li>)}
                </ul>
                {/* Each link also names its project for a screen reader, which hears the links out of context. */}
                <ul class="doors">
                  <li>
                    <a class="go" href={`/projects/${id}`}>
                      Case study<span class="visually-hidden">: {data.title}</span>
                      <span aria-hidden="true">&nbsp;→</span>
                    </a>
                  </li>
                  {data.live && (
                    <li>
                      <a href={data.live}>
                        Live site<span class="visually-hidden">: {data.title}</span>
                      </a>
                    </li>
                  )}
                  <li>
                    <a href={data.code}>
                      Code<span class="visually-hidden">: {data.title}</span>
                    </a>
                  </li>
                  {data.video && (
                    <li>
                      <a href={data.video}>
                        Demo video<span class="visually-hidden">: {data.title}</span>
                      </a>
                    </li>
                  )}
                </ul>
              </div>
            </article>
          </li>
        ))
      }
    </ol>

    <Onward
      links={[
        { label: 'At work', text: 'Issues that now fix themselves', href: '/self-healing' },
        { label: 'This site', text: 'How this site runs', href: '/how-this-site-runs' },
        { label: 'Resume', text: 'The resume (PDF)', href: site.resumePdf },
      ]}
    />
  </div>
</Base>

<style>
  /* The heading is one short line on a wide screen, so it gets more than the shared 20ch. */
  .page-head h1 {
    max-width: 30ch;
  }

  .projects {
    display: grid;
    gap: var(--space-5);
    margin-block: var(--space-6) var(--space-8);
  }

  /* A row is never wider than its column, whatever is inside it. */
  .projects > li {
    min-width: 0;
  }

  /* Picture beside the words where both fit, above them where they do not. */
  .project {
    display: flex;
    flex-wrap: wrap;
    overflow: hidden;
  }

  .shot {
    position: relative;
    flex: 1 1 21.25rem;
    min-width: 0;
    min-height: 13.75rem;
    background: var(--paper-sunk);
  }

  /* The picture fills whatever height the words beside it need, kept to its top left corner. */
  .shot :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }

  .text {
    flex: 1 1 23.75rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
  }

  .top h2 {
    overflow-wrap: anywhere;
  }

  .number,
  .kind {
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }

  .kind.live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent);
  }

  .kind.live::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: currentColor;
  }

  .proof {
    padding: var(--space-3) 0.875rem;
    border-radius: var(--radius-sm);
    background: var(--paper-sunk);
    font-size: 0.9375rem;
  }

  .doors {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-5);
    margin-top: auto;
  }

  .doors a {
    display: inline-flex;
    align-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
  }

  .doors a:not(.go) {
    color: var(--ink-soft);
    text-decoration-color: var(--rule-strong);
  }

  .doors a:not(.go):hover {
    color: var(--ink);
    text-decoration-color: var(--accent);
  }

  @media (min-width: 52rem) {
    .text {
      padding: var(--space-6);
    }
  }
</style>
