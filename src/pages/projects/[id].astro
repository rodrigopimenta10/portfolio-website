---
// One side project's case study. The page is the same for all three: the facts and the pictures
// come from the project's frontmatter, the text from its Markdown, and the architecture figure
// goes where the Markdown says.
import { Image } from 'astro:assets';
import Onward from '../../components/Onward.astro';
import AwsPlatformDiagram from '../../components/diagrams/AwsPlatformDiagram.astro';
import OrbitalWatchDiagram from '../../components/diagrams/OrbitalWatchDiagram.astro';
import Base from '../../layouts/Base.astro';
import { allProjects, bodyAroundArchitecture, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await allProjects();
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project, others: projects.filter((other) => other.id !== project.id) },
  }));
}

interface Props {
  project: Project;
  others: Project[];
}

const { project, others } = Astro.props;
const { data } = project;
const { architecture } = data;
const diagrams = { 'orbital-watch': OrbitalWatchDiagram, 'aws-platform-terraform': AwsPlatformDiagram };
const Diagram = architecture.diagram ? diagrams[architecture.diagram] : null;
const body = bodyAroundArchitecture(project);
---

<Base
  title={data.title}
  path={`/projects/${project.id}`}
  description={data.summary}
  image={{ src: `/og-${project.id}.png`, alt: `${data.title}, a project by Rodrigo Pimenta. ${data.screenshot.alt}` }}
>
  <article class="wrap">
    <nav class="back" aria-label="Breadcrumb">
      <a href="/projects"><span aria-hidden="true">←&nbsp;</span>Side projects</a>
    </nav>

    <header class="page-head">
      <p class="eyebrow">Outside work · {data.live ? 'live' : 'public code'}</p>
      <h1>{data.title}</h1>
      <p class="lede">{data.summary}</p>
      <p class="doors">
        {
          data.live && (
            <a class="button" href={data.live}>
              Open the live site
            </a>
          )
        }
        <a class:list={['button', { quiet: Boolean(data.live) }]} href={data.code}>Read the code</a>
        {
          data.video && (
            <a class="button quiet" href={data.video}>
              Watch the demo video
            </a>
          )
        }
      </p>
      <dl class="facts">
        <div class="good">
          <dt>My part</dt>
          <dd>{data.role}</dd>
        </div>
        <div class="good">
          <dt>Result</dt>
          <dd><strong>{data.result}</strong></dd>
        </div>
        <div>
          <dt>Built with</dt>
          <dd>{data.stack.join(', ')}.</dd>
        </div>
      </dl>
    </header>

    <figure class="shot">
      <a class="frame" href={data.live ?? data.code}>
        <Image
          src={data.screenshot.src}
          alt={data.screenshot.alt}
          widths={[480, 720, 960, 1440, 1920, 2880]}
          sizes="(min-width: 78rem) 76rem, calc(100vw - 2.25rem)"
          loading="eager"
        />
      </a>
      <figcaption>{data.screenshot.caption}</figcaption>
    </figure>

    <section class="section study" aria-label="The case study">
      <div class="prose" set:html={body.before} />

      <figure class="architecture">
        <p class="eyebrow">Architecture</p>
        <div class="frame scroller" tabindex="0" role="group" aria-label="Architecture diagram. Scrolls sideways on a small screen.">
          {
            architecture.image && (
              <Image
                class="picture"
                src={architecture.image.src}
                alt={architecture.image.alt}
                widths={[900, 1216, 1800, 2428]}
                sizes="(min-width: 78rem) 76rem, max(56.25rem, calc(100vw - 2.25rem))"
                loading="lazy"
              />
            )
          }
          {
            Diagram && (
              <div class="drawn">
                <Diagram />
              </div>
            )
          }
        </div>
        <figcaption>{architecture.caption}</figcaption>
      </figure>

      <div class="prose" set:html={body.after} />
    </section>

    <Onward
      links={[
        ...others.map((other) => ({ label: 'Next project', text: other.data.title, href: `/projects/${other.id}` })),
        { label: 'At work', text: 'Issues that now fix themselves', href: '/self-healing' },
      ]}
    />
  </article>
</Base>

<style>
  .back {
    padding-top: var(--space-4);
  }

  .back a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .back a:hover {
    color: var(--accent);
  }

  /* The way back sits above the heading, so the heading needs less air than on a tab's own page. */
  .page-head {
    padding-top: var(--space-4);
  }

  /* A project's name is one word or two, and "aws-platform-terraform" may break at its hyphens. */
  .page-head h1 {
    max-width: none;
    overflow-wrap: anywhere;
  }

  .doors {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .page-head .facts {
    grid-template-columns: repeat(auto-fit, minmax(min(16.25rem, 100%), 1fr));
    margin-top: var(--space-2);
  }

  .shot .frame {
    display: block;
    background: var(--paper-sunk);
  }

  .shot :global(img) {
    width: 100%;
  }

  .study {
    margin-top: var(--space-6);
    border-top: 1px solid var(--rule);
  }

  /* The body is Markdown turned into HTML, which a scoped rule reaches only through :global. */
  .prose :global(p) {
    color: var(--ink-soft);
  }

  .architecture {
    margin-block: var(--space-7);
  }

  /* Wider than a phone: the frame scrolls sideways, the page does not. */
  .scroller {
    margin-top: var(--space-3);
    overflow-x: auto;
  }

  .scroller :global(.picture) {
    width: 100%;
    min-width: 56.25rem;
    max-width: none;
  }

  .drawn {
    min-width: 43rem;
    padding: var(--space-5);
  }

  .architecture figcaption {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }
</style>
