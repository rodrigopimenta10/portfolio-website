---
// How the site is hosted, what the status panel does when a check fails, and what was left out.
// While `site.hosting.live` is false the page says plainly that this is built but not deployed.
import Onward from '../components/Onward.astro';
import SiteDiagram from '../components/diagrams/SiteDiagram.astro';
import { site } from '../data/site';
import Base from '../layouts/Base.astro';

const live = site.hosting.live;
const asOf = new Date(`${site.hosting.asOf}T00:00:00Z`).toLocaleDateString('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const failures = [
  { when: 'One source is slow or down', then: 'Its row says “could not check” with the reason and the last known answer. The other rows are unaffected.' },
  { when: 'GitHub’s rate limit is used up', then: 'The AWS row says so, with the time the limit resets, and the service stops asking until then.' },
  { when: 'The status service is cold', then: 'The panel shows “checking”, then a line explaining the wait. Pages are already on screen.' },
  { when: 'The status service is down', then: 'Every row says “could not check”, the panel says nothing on it is live, and offers to try again. Pages still load.' },
  { when: 'A source reports its own trouble', then: 'The row says “degraded” and repeats what the source said, for example how many of Orbital Watch’s feeds are stale.' },
];

const leftOut = [
  { what: 'No load balancer', why: 'Firebase Hosting already gives a CDN, a certificate and the /api rewrite.' },
  { what: 'No warm instances', why: 'The first request after a quiet spell waits a few seconds, and the panel says so while it waits.' },
  { what: 'No server rendering', why: 'A page that is a file cannot be down because a server is.' },
  {
    what: 'No database, cookies or third-party scripts',
    why: 'Nothing here needs them. Page views are counted by one request to the status service, and not when the browser asks not to be tracked.',
  },
  { what: 'No secrets', why: 'Every source the service reads is public.' },
];
---

<Base title="How this site runs" path="/how-this-site-runs" description="Static pages on Firebase Hosting, one Cloud Run service that scales to zero, Terraform, and keyless deploys from GitHub Actions. What was left out on purpose.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">How this site runs</p>
      <h1>Files on a CDN, and one small service that is allowed to sleep</h1>
      <p class="lede">
        The site argues that a system should keep itself running and say when it cannot. This page
        is how it tries to live up to that.
      </p>
    </header>

    {
      !live && (
        <aside class="notice" aria-label="Deployment status">
          <p class="eyebrow">Not live yet · as of {asOf}</p>
          <p>
            Everything described here is written, and what can be tested without a cloud account
            has been. Nothing has been created in Google Cloud and nothing is deployed:
            rodrigopimenta.com still serves the previous version of this site.
          </p>
        </aside>
      )
    }

    <div class="served">
      <SiteDiagram>
        The same shape is in <code>firebase.json</code>, the workflows and the Terraform.
      </SiteDiagram>
    </div>

    <section class="section" id="status" aria-labelledby="panel-title">
      <div class="section-head">
        <h2 id="panel-title">The status panel</h2>
      </div>
      <div class="prose soft">
        <p>
          <a href="/projects#status">The panel</a> is the only part of the site that is not a file.
          After the page has painted, the browser asks <code>/api/status</code>, and the service
          answers with one row per system. Each call gets four seconds, and answers are kept for a
          minute.
        </p>
        <p>
          A check that fails never becomes an error page and never becomes “up”. It becomes “could
          not check”, with the reason.
        </p>
      </div>
      <table class="failures">
        <caption class="eyebrow">What you see when something fails</caption>
        <thead>
          <tr>
            <th scope="col">When</th>
            <th scope="col">The panel</th>
          </tr>
        </thead>
        <tbody>
          {
            failures.map((failure) => (
              <tr>
                <th scope="row">{failure.when}</th>
                <td>{failure.then}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="section" aria-labelledby="left-out-title">
      <div class="section-head">
        <h2 id="left-out-title">Left out on purpose</h2>
      </div>
      <dl class="left-out">
        {
          leftOut.map((item) => (
            <div>
              <dt>{item.what}</dt>
              <dd>{item.why}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="section" aria-labelledby="source-title">
      <div class="section-head">
        <h2 id="source-title">Read it yourself</h2>
      </div>
      <div class="prose soft">
        <p>
          The site, the status service, the hosting configuration and the workflows are in
          <a href={site.repo}>one public repository</a>, and so is the Terraform, in its
          <a href={`${site.repo}/tree/main/infra`}><code>infra/</code> folder</a>.
        </p>
      </div>
    </section>

    <Onward
      links={[
        { label: 'Side projects', text: 'Three you can open and check', href: '/projects' },
        { label: 'At work', text: 'Issues that now fix themselves', href: '/self-healing' },
        { label: 'Resume', text: 'The resume (PDF)', href: site.resumePdf },
      ]}
    />
  </div>
</Base>

<style>
  .notice {
    display: grid;
    gap: var(--space-2);
    max-width: 52rem;
    margin-bottom: var(--space-6);
    padding: var(--space-4) var(--space-5);
    border: 1px dashed var(--state-degraded);
    border-radius: var(--radius);
    background: var(--wash-degraded);
  }

  .notice .eyebrow {
    color: var(--state-degraded);
  }

  .served {
    padding-bottom: var(--space-8);
  }

  /* The diagram is not a section, so the first section draws its own line above. */
  .served + .section {
    border-top: 1px solid var(--rule);
  }

  .failures {
    width: 100%;
    max-width: 56rem;
    margin-top: var(--space-6);
    border-collapse: collapse;
    text-align: left;
  }

  caption {
    padding-bottom: var(--space-3);
    text-align: left;
  }

  th,
  td {
    padding: var(--space-3) var(--space-4) var(--space-3) 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }

  th {
    font-weight: 600;
  }

  td {
    color: var(--ink-soft);
  }

  .left-out {
    border-top: 1px solid var(--rule);
  }

  .left-out > div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--rule);
  }

  .left-out dt {
    flex: 0 0 11rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .left-out dd {
    flex: 1 1 17.5rem;
    min-width: 0;
    margin: 0;
  }

  /* On a narrow screen the two columns would squeeze each other: each row becomes a small block,
     with the column names left to screen readers. */
  @media (max-width: 43.99rem) {
    .failures,
    .failures caption,
    .failures tbody,
    .failures tr,
    .failures th,
    .failures td {
      display: block;
    }

    .failures thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .failures tbody tr {
      padding-block: var(--space-3);
      border-bottom: 1px solid var(--rule);
    }

    .failures tbody tr:first-child {
      border-top: 1px solid var(--rule);
    }

    .failures th,
    .failures td {
      padding: 0;
      border: 0;
    }

    .failures td {
      margin-top: var(--space-1);
    }
  }

  @media (min-width: 44rem) {
    .failures tbody th {
      width: 38%;
    }
  }
</style>
