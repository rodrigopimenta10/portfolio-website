---
import { Image } from 'astro:assets';
import sightline from '../assets/screens/sightline.webp';
import SiteDiagram from '../components/diagrams/SiteDiagram.astro';
import StatusLine from '../components/StatusLine.astro';
import StorageSim from '../components/StorageSim.astro';
import { site } from '../data/site';
import Base from '../layouts/Base.astro';
import { resumeLine } from '../lib/projects';

// The resume says both of these in these words. The build stops if it no longer does, so the
// numbers on this page cannot drift from the document a recruiter opens next.
resumeLine('on call 24/7 against a 99.9% SLA');
resumeLine("Authored the platform's Kubernetes migration design covering 161 scheduled jobs");

// Four figures under the first screen. Two of them lead into the chapter that explains them.
const figures: { value: string; unit: string; label: string; href?: string }[] = [
  { value: '6+', unit: 'years', label: 'of Python in production' },
  { value: '99.9%', unit: 'SLA', label: 'availability target, on call 24/7', href: '/on-call' },
  { value: 'Zero', unit: 'touch', label: 'self-heal automations, built as follow-ups to on-call issues', href: '/self-healing' },
  { value: '161', unit: 'jobs', label: 'covered by the Kubernetes migration design I authored' },
];

// The work, as three chapters. Each is a tab in the header, in the same order.
const chapters = [
  {
    href: '/on-call',
    step: '01 · On call',
    title: '2:00 AM. Thousands of customers have no internet.',
    text: 'One incident, minute by minute, and how service came back in 26 minutes.',
    go: 'Read the incident',
  },
  {
    href: '/tools',
    step: '02 · Tools',
    title: 'One command checks every device at once.',
    text: 'Scripts and a dashboard that do the looking for the whole team.',
    go: 'Step through the scripts',
  },
  {
    href: '/self-healing',
    step: '03 · Self-healing',
    title: 'Issues fixed before they become outages, with nobody called.',
    text: 'Two simulations: break a node and watch the monitor heal it, or refuse to.',
    go: 'Play the simulations',
  },
];

const sightlineLive = 'https://lunarsightline.com';
const sightlineVideo = 'https://youtu.be/YJMlGcogtI0';
---

<Base path="/">
  <div class="hero-band">
    <div class="backdrop" aria-hidden="true"></div>
    <div class="wrap">
      <section class="hero" aria-labelledby="who">
        <div class="who">
          <p class="eyebrow role">Backend and platform software engineer · Relocating to New York</p>
          <h1 id="who">I build systems that keep themselves running, <em class="grad">and say so when they can’t.</em></h1>
          <p class="pitch">
            Systems Engineer III at Hughes Network Systems since 2021. I automate the failures that
            take satellite internet down, and I set the engineering standards for my department.
          </p>
          {/* What a recruiter came for, before anything else: on a phone these sit above the simulation. */}
          <ul class="doors">
            <li>
              <a class="button primary" href={site.resumePdf}>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3v10m0 0 4-4m-4 4-4-4M4 16.5h12"></path></svg>
                Resume (PDF)
              </a>
            </li>
            <li>
              <a class="button quiet" href={site.bookCall}>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4.5" width="14" height="12" rx="2.5"></rect><path d="M3 8.5h14M7 3v3m6-3v3"></path></svg>
                Book a 30-minute call
              </a>
            </li>
          </ul>
          <ul class="reach" aria-label="Other ways to reach me">
            <li>
              <a href={`mailto:${site.email}`}>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="15" height="11" rx="2.5"></rect><path d="m3.5 6.5 6.5 5 6.5-5"></path></svg>
                Email me
              </a>
            </li>
            <li>
              <a href={site.linkedin}>
                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M4.2 7.6h2.5v8.2H4.2zM5.45 3.9a1.45 1.45 0 1 1 0 2.9 1.45 1.45 0 0 1 0-2.9zM8.3 7.6h2.4v1.1h.03c.33-.63 1.15-1.3 2.37-1.3 2.53 0 3 1.67 3 3.83v4.57h-2.5v-4.05c0-.97-.02-2.2-1.34-2.2-1.35 0-1.55 1.05-1.55 2.13v4.12H8.3z"></path></svg>
                LinkedIn
              </a>
            </li>
            <li>
              <a href={site.github}>
                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 2.2a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.5c-2.23.49-2.7-.95-2.7-.95-.36-.93-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.72 1.22 1.88.87 2.33.66.07-.52.28-.87.5-1.07-1.77-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 10 2.2z"></path></svg>
                GitHub
              </a>
            </li>
          </ul>
          <p class="seeking"><span class="pulse" aria-hidden="true"></span>{site.seeking}</p>
        </div>

        {/* The claim in the headline, made checkable: one cluster of the simulation on the Self-healing tab. */}
        <aside class="try surface" aria-label="A small simulation: break a node and watch the monitor">
          <StorageSim compact />
          <a class="go" href="/self-healing">The full simulations <span aria-hidden="true">&nbsp;→</span></a>
        </aside>
      </section>

      <ul class="figures" aria-label="In numbers">
        {
          figures.map((figure) => {
            const Cell = figure.href ? 'a' : 'div';
            return (
              <li>
                <Cell class="figure" href={figure.href}>
                  <span class="top">
                    <span class="value">{figure.value}</span> <span class="unit">{figure.unit}</span>
                  </span>
                  <span class="label">{figure.label}</span>
                </Cell>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>

  <div class="wrap">
    <section class="section" id="work" aria-labelledby="work-title">
      <div class="section-head">
        <p class="eyebrow">Systems Engineer III · Hughes Network Systems · Nov 2021 to present</p>
        <h2 id="work-title">From 2 AM outage calls to issues that fix themselves</h2>
        <p class="measure soft">
          Three steps, one tab each. Names are made up because the code is my employer’s. The numbers
          are real.
        </p>
      </div>
      <ol class="chapters">
        {
          chapters.map((chapter) => (
            <li>
              <a class="chapter surface" href={chapter.href}>
                <span class="eyebrow step">{chapter.step}</span>
                <span class="title">{chapter.title}</span>
                <span class="soft">{chapter.text}</span>
                <span class="more">
                  {chapter.go} <span aria-hidden="true">→</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section" id="projects" aria-labelledby="projects-title">
      <div class="section-head">
        <p class="eyebrow">Outside work</p>
        <h2 id="projects-title">Three you can open and check</h2>
        <p class="measure soft">Each one is live or public. A status panel checks them as you read this.</p>
      </div>

      <article class="lead surface">
        <a class="shot" href={sightlineLive} aria-label="Open Sightline, the live site">
          <Image
            src={sightline}
            alt="Sightline: the Moon seen from above its south pole, with marked landing sites and a time bar"
            widths={[480, 720, 1080, 1440]}
            sizes="(min-width: 60rem) 34rem, 100vw"
          />
        </a>
        <div class="about">
          <h3>
            <span class="eyebrow number">01</span>
            Sightline
            <span class="tag built">live</span>
          </h3>
          <p>
            A lunar landing-site planner: when the Sun and Earth are in view from the Moon’s south
            pole, every hour from 2026 to 2049.
          </p>
          <p class="soft">0.0071° from JPL Horizons over 5,469,984 hourly checks.</p>
          <ul class="links">
            <li><a class="go" href={sightlineLive}>Open the live site <span aria-hidden="true">&nbsp;→</span></a></li>
            <li><a href="/projects/sightline">Case study</a></li>
            <li><a href={sightlineVideo}>Demo video</a></li>
          </ul>
        </div>
      </article>

      <ul class="others">
        <li>
          <a class="other surface" href="/projects/orbital-watch">
            <span class="name">
              <span class="eyebrow number">02</span>
              Orbital Watch
              <span class="tag built">live</span>
            </span>
            <span>Satellite passes next to live space weather, on a page that reports how fresh its own data is.</span>
            <span class="soft">Seven sources, each marked fresh, stale or failed.</span>
            <span class="more">Case study <span aria-hidden="true">→</span></span>
          </a>
        </li>
        <li>
          <a class="other surface" href="/projects/aws-platform-terraform">
            <span class="name">
              <span class="eyebrow number">03</span>
              aws-platform-terraform
              <span class="tag">public code</span>
            </span>
            <span>A production-style AWS platform in Terraform, built as reusable, tested modules.</span>
            <span class="soft">Applied to a real AWS account and destroyed again, with no stored keys.</span>
            <span class="more">Case study <span aria-hidden="true">→</span></span>
          </a>
        </li>
      </ul>

      <StatusLine />
    </section>

    <section class="section" id="site" aria-labelledby="site-title">
      <div class="section-head">
        <p class="eyebrow">This site</p>
        <h2 id="site-title">Built the way I build at work</h2>
        <p class="measure soft">
          Static files on a CDN, one small service that is allowed to sleep, and all of it declared
          in Terraform.
        </p>
      </div>
      <SiteDiagram />
      <a class="go" href="/how-this-site-runs">How this site runs <span aria-hidden="true">&nbsp;→</span></a>
    </section>
  </div>
</Base>

<style>
  .hero-band {
    position: relative;
    overflow: clip;
  }

  /* Two soft glows and a dot grid behind the first screen. Decoration only. */
  .backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(42rem 26rem at 88% 18%, var(--glow-1), transparent 70%),
      radial-gradient(36rem 24rem at 8% 0%, var(--glow-2), transparent 70%),
      radial-gradient(var(--dot) 1px, transparent 1.2px) 0 0 / 22px 22px;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }

  .hero-band > .wrap {
    position: relative;
    padding-bottom: var(--space-7);
  }

  .hero {
    display: grid;
    /* On a phone: who he is and the ways in, then the simulation. */
    grid-template-areas: 'who' 'try';
    gap: var(--space-6);
    padding-block: var(--space-6);
  }

  .who {
    grid-area: who;
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .role {
    color: var(--accent);
  }

  h1 {
    font-size: var(--text-hero);
    line-height: 1.02;
    letter-spacing: -0.045em;
    font-weight: 650;
  }

  h1 em {
    font-style: normal;
  }

  .pitch {
    max-width: 36rem;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .doors {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  /* The resume is the one action in green: it is what most visitors came for. */
  .button.primary {
    min-height: 3.25rem;
    padding-inline: 1.5rem;
    background: var(--accent);
    color: var(--accent-ink);
    box-shadow: 0 8px 26px -8px var(--accent);
  }

  .button.primary:hover {
    background: var(--ink);
    color: var(--paper);
    box-shadow: none;
  }

  .doors .button.quiet {
    min-height: 3.25rem;
  }

  .reach {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
  }

  .reach a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 120ms ease;
  }

  .reach a:hover {
    color: var(--accent);
  }

  .reach svg {
    width: 1.2rem;
    height: 1.2rem;
    flex: none;
  }

  .seeking {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: 600;
  }

  /* A pulse beside "open to roles", twice and then still: a small sign that this page is current. */
  .pulse {
    position: relative;
    flex: none;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0;
    animation: pulse 2.2s ease-out 2;
  }

  @keyframes pulse {
    from {
      transform: scale(1);
      opacity: 0.55;
    }
    to {
      transform: scale(3);
      opacity: 0;
    }
  }

  .try {
    grid-area: try;
    display: grid;
    gap: var(--space-2);
    align-content: start;
    min-width: 0;
    padding: var(--space-5);
  }

  /* Four figures in one frame under the first screen. */
  .figures {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-raised);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .figures li {
    display: grid;
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
    margin: -1px 0 0 -1px;
  }

  .figure {
    display: grid;
    gap: var(--space-1);
    align-content: start;
    padding: var(--space-5);
    text-decoration: none;
  }

  a.figure {
    transition: background-color 140ms ease;
  }

  a.figure:hover {
    background: var(--paper-sunk);
  }

  .figure .top {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .figure .value {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .figure .unit {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .figure .label {
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  /* The three chapters of the work, side by side where there is room. */
  .chapters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17.5rem, 100%), 1fr));
    gap: var(--space-4);
  }

  .chapters li {
    display: grid;
  }

  .chapter,
  .other {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-5);
    text-decoration: none;
    transition:
      border-color 140ms ease,
      transform 140ms ease,
      box-shadow 140ms ease;
  }

  .chapter:hover,
  .other:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lift);
  }

  .step,
  .number {
    color: var(--accent);
  }

  .chapter .title {
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .more {
    margin-top: var(--space-2);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent);
  }

  /* Sightline leads the side projects: the picture is the way in. */
  .lead {
    display: grid;
    overflow: hidden;
  }

  .shot {
    display: block;
    background: var(--paper-sunk);
  }

  .shot img {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .shot:hover img {
    transform: scale(1.02);
  }

  .about {
    display: grid;
    gap: var(--space-3);
    align-content: center;
    padding: var(--space-5);
  }

  .about h3,
  .name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .name {
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .about h3 {
    font-size: var(--text-xl);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-5);
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9375rem;
  }

  .others {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17.5rem, 100%), 1fr));
    gap: var(--space-4);
    margin-block: var(--space-4);
  }

  .others li {
    display: grid;
  }

  #site .go {
    margin-top: var(--space-3);
  }

  @media (min-width: 44rem) {
    .figures {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 60rem) {
    .lead {
      grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
    }
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      grid-template-areas: 'who try';
      column-gap: var(--space-8);
      align-items: start;
      padding-block: var(--space-8) var(--space-7);
    }

    .who {
      gap: var(--space-5);
    }
  }
</style>
