---
import { Image } from 'astro:assets';
import portrait from '../assets/rodrigo.jpg';
import FeaturedProject from '../components/FeaturedProject.astro';
import StatusPanel from '../components/StatusPanel.astro';
import { site } from '../data/site';
import Base from '../layouts/Base.astro';
import { allProjects, isPersonal, isWork, resumeWords } from '../lib/projects';

const projects = await allProjects();
const featured = projects.filter(isPersonal);
const atWork = projects.filter(isWork);

// The four figures under the first screen. Each is the resume's own number, in the resume's words.
const figures = [
  { value: '6+', unit: 'years', label: 'of Python in production' },
  { value: '99.9%', unit: 'SLA', label: 'held on call, 24/7' },
  { value: '24', unit: 'nodes', label: 'of storage in 8 clusters, watched and healed every 3 minutes' },
  { value: '2,020', unit: 'tests', label: 'in Sightline’s CI; deploys go out as a canary' },
];

// The headline number of each system at work, from the same resume lines the page quotes below it.
const headline: Record<string, { value: string; label: string }> = {
  'ceph-storage-self-healing-monitor': { value: '~130', label: 'verified failovers a month, no human involved' },
  'config-integrity-self-heal': { value: '~295', label: 'remediations a month, 89% inside one polling cycle' },
};
---

<Base path="/">
  <div class="hero-band">
    <div class="backdrop" aria-hidden="true"></div>
    <div class="wrap">
      <section class="hero" aria-labelledby="who">
        <div class="who">
          <p class="id">
            <Image class="portrait" src={portrait} alt="Rodrigo Pimenta" width={56} height={56} densities={[1, 2, 3]} loading="eager" />
            <span class="eyebrow">Backend and platform engineer · Relocating to New York</span>
          </p>
          <h1 id="who">
            <span class="hello">I’m Rodrigo Pimenta.</span> I build systems that keep themselves running and <em class="grad">say so when they can’t</em>.
          </h1>
          <p class="pitch">
            Six-plus years in Python: self-healing automation, asyncio services, PostgreSQL and CI/CD,
            on call 24/7 against a 99.9% availability SLA at Hughes Network Systems. Outside work I
            build on Google Cloud and AWS with Terraform.
          </p>
          {/* What a recruiter came for, before anything else: on a phone these sit above the panel. */}
          <ul class="doors">
            <li>
              <a class="button" href={site.resumePdf}>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3v10m0 0 4-4m-4 4-4-4M4 16.5h12" /></svg>
                Resume (PDF)
              </a>
            </li>
            <li>
              <a class="button quiet" href={site.bookCall}>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4.5" width="14" height="12" rx="2.5" /><path d="M3 8.5h14M7 3v3m6-3v3" /></svg>
                Book a 30-minute call
              </a>
            </li>
          </ul>
          <ul class="reach" aria-label="Other ways to reach me">
            <li>
              <a href={`mailto:${site.email}`}>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="15" height="11" rx="2.5" /><path d="m3.5 6.5 6.5 5 6.5-5" /></svg>
                Email me
              </a>
            </li>
            <li>
              <a href={site.linkedin}>
                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M4.2 7.6h2.5v8.2H4.2zM5.45 3.9a1.45 1.45 0 1 1 0 2.9 1.45 1.45 0 0 1 0-2.9zM8.3 7.6h2.4v1.1h.03c.33-.63 1.15-1.3 2.37-1.3 2.53 0 3 1.67 3 3.83v4.57h-2.5v-4.05c0-.97-.02-2.2-1.34-2.2-1.35 0-1.55 1.05-1.55 2.13v4.12H8.3z" /></svg>
                LinkedIn
              </a>
            </li>
            <li>
              <a href={site.github}>
                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 2.2a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.5c-2.23.49-2.7-.95-2.7-.95-.36-.93-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.72 1.22 1.88.87 2.33.66.07-.52.28-.87.5-1.07-1.77-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 10 2.2z" /></svg>
                GitHub
              </a>
            </li>
          </ul>
          <p class="seeking"><span class="pulse" aria-hidden="true"></span>{site.seeking}</p>
        </div>

        <div class="panel">
          <StatusPanel />
        </div>
      </section>

      <dl class="figures" aria-label="In numbers">
        {
          figures.map((figure) => (
            <div>
              <dt>
                <span class="value">{figure.value}</span> <span class="unit">{figure.unit}</span>
              </dt>
              <dd>{figure.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <div class="wrap">
    <section class="section" aria-labelledby="projects-title">
      <div class="section-head">
        <p class="eyebrow">Projects</p>
        <h2 id="projects-title">Things you can open and check</h2>
        <p class="measure soft">Each one is live or public. The status panel above is checking them as you read this.</p>
      </div>
      <div class="featured">
        {featured.map((project, index) => <FeaturedProject project={project} index={index} />)}
      </div>
    </section>

    <section class="section" aria-labelledby="work-title">
      <div class="section-head">
        <p class="eyebrow">At Hughes Network Systems</p>
        <h2 id="work-title">Two systems in production</h2>
        <p class="measure soft">
          This code belongs to my employer and is not public, so these are described in my resume’s
          words and no others.
        </p>
      </div>
      <div class="work">
        {
          atWork.map((project) => {
            const words = resumeWords(project);
            const top = headline[project.id];
            return (
              <article class="surface">
                {top && (
                  <p class="top">
                    <span class="value grad">{top.value}</span>
                    <span class="what">{top.label}</span>
                  </p>
                )}
                <h3>
                  <a class="stretch" href={`/projects/${project.id}`}>
                    {project.data.title}
                  </a>
                </h3>
                <p class="soft">{words.sentences.slice(0, 2).join(' ')}</p>
                <ul class="chips">
                  {words.stack.map((item) => <li class="tag">{item}</li>)}
                </ul>
                <p class="go" aria-hidden="true">
                  Read how it works <span>→</span>
                </p>
              </article>
            );
          })
        }
      </div>
      <p class="after">
        <a class="button quiet" href="/projects/ceph-storage-self-healing-monitor#sim-title">Try the failover idea as a simulation</a>
        <a class="button quiet" href="/experience">All experience</a>
      </p>
    </section>
  </div>
</Base>

<style>
  .hero-band {
    position: relative;
    overflow: clip;
  }

  /* Two soft glows and a dot grid behind the first screen. Decoration only. */
  .backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(42rem 26rem at 88% 18%, var(--glow-1), transparent 70%),
      radial-gradient(36rem 24rem at 8% 0%, var(--glow-2), transparent 70%),
      radial-gradient(var(--dot) 1px, transparent 1.2px) 0 0 / 22px 22px;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }

  .hero-band > .wrap {
    position: relative;
  }

  .hero {
    display: grid;
    /* On a phone: who he is and the ways in, then the live panel. */
    grid-template-areas: 'who' 'panel';
    gap: var(--space-6);
    padding-block: var(--space-6) var(--space-6);
  }

  .who {
    grid-area: who;
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  h1 {
    font-size: var(--text-hero);
    line-height: 1.02;
    letter-spacing: -0.045em;
    font-weight: 650;
    text-wrap: balance;
  }

  h1 em {
    font-style: normal;
  }

  /* His name leads the heading at a quieter size; the claim is the large part. */
  h1 .hello {
    display: block;
    margin-bottom: var(--space-3);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--ink-soft);
  }

  .pitch {
    max-width: 36rem;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .panel {
    grid-area: panel;
    min-width: 0;
  }

  .seeking {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: 600;
  }

  /* A slow pulse beside "open to roles": a small sign that this page is current. */
  .pulse {
    position: relative;
    flex: none;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2.4s ease-out infinite;
  }

  @keyframes pulse {
    from {
      transform: scale(1);
      opacity: 0.55;
    }
    to {
      transform: scale(3);
      opacity: 0;
    }
  }

  .id {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .id .eyebrow {
    color: var(--accent);
  }

  .portrait {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    border: 2px solid var(--paper-raised);
    box-shadow: 0 0 0 2px var(--accent);
    object-fit: cover;
    flex: none;
  }

  .doors {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .reach {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
  }

  .reach a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 120ms ease;
  }

  .reach a:hover {
    color: var(--accent);
  }

  .reach svg {
    width: 1.2rem;
    height: 1.2rem;
    flex: none;
  }

  /* Four figures in a row under the first screen. */
  .figures {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-raised);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .figures > div {
    display: grid;
    gap: var(--space-1);
    align-content: start;
    padding: var(--space-5);
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
    margin: -1px 0 0 -1px;
  }

  .figures dt {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .figures .value {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .figures .unit {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .figures dd {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .featured {
    display: grid;
    gap: var(--space-5);
  }

  .work {
    display: grid;
    gap: var(--space-5);
  }

  .work article {
    position: relative;
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-6);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .work article:hover {
    transform: translateY(-3px);
    border-color: var(--rule-strong);
    box-shadow: var(--shadow-lift);
  }

  .work .top {
    display: grid;
    gap: var(--space-1);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--rule);
  }

  .work .top .value {
    font-size: clamp(2.5rem, 1.8rem + 2.6vw, 3.5rem);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1;
    width: fit-content;
  }

  .work .top .what {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .work h3 a {
    text-decoration: none;
  }

  /* The whole card is the link: the title's link is stretched over it. */
  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .go {
    margin-top: var(--space-1);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent);
  }

  .go span {
    display: inline-block;
    transition: transform 160ms ease;
  }

  .work article:hover .go span {
    transform: translateX(4px);
  }

  .after {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  @media (min-width: 44rem) {
    .work {
      grid-template-columns: 1fr 1fr;
    }

    .featured {
      grid-template-columns: 1fr 1fr;
    }

    .figures {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      grid-template-areas: 'who panel';
      column-gap: var(--space-8);
      align-items: start;
      padding-block: var(--space-8) var(--space-7);
    }

    .who {
      gap: var(--space-5);
    }
  }
</style>
