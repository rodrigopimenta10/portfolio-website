---
// How this site is served, as a board of boxes and arrows. Matches firebase.json,
// .github/workflows/ and the Terraform in infra/.
//
// The words are here, the positions are in the stylesheet below (one rule per box, in board
// units), and the arrows are a drawing laid over the boxes. A complete figure: it brings its own
// frame, scrolls sideways inside it when the screen is narrower than the board, and takes more
// caption text in its slot.
import { site } from '../../data/site';

interface Box {
  id: string;
  name: string;
  what?: string;
  /** Code in this repository, as opposed to a managed or outside service. */
  ours?: boolean;
}

interface Area {
  id: string;
  name: string;
  boxes: Box[];
  note?: string;
}

const areas: Area[] = [
  {
    id: 'edge',
    name: 'Edge',
    boxes: [
      {
        id: 'browser',
        name: 'Visitor’s browser',
        what: 'Loads plain HTML first, then asks /api/status once the page has painted.',
      },
      { id: 'dns', name: 'Cloudflare DNS', what: 'Answers where rodrigopimenta.com is. Carries no traffic.' },
      {
        id: 'hosting',
        name: 'Firebase Hosting · CDN',
        what: 'Serves the static files over HTTPS and passes /api/** to the status service.',
      },
      {
        id: 'files',
        name: 'Static files · Astro',
        what: 'Every page is built to plain HTML. Styles, scripts, images and the resume PDF are cached at the edge.',
        ours: true,
      },
    ],
  },
  {
    id: 'request',
    name: 'Request path · Cloud Run, us-east4',
    boxes: [
      {
        id: 'status',
        name: 'portfolio-status',
        what: 'FastAPI on Cloud Run. Zero to two instances, so it is allowed to sleep. Asks three public sources at once and keeps each answer for a minute.',
        ours: true,
      },
      { id: 'sightline', name: 'Sightline', what: '/api/status names the live revision.' },
      { id: 'orbital-watch', name: 'Orbital Watch', what: 'latest.json says how fresh its data is.' },
      { id: 'github-api', name: 'GitHub API', what: 'The AWS platform’s last live drill.' },
      {
        id: 'failed-check',
        name: 'When a check fails',
        what: 'It never becomes an error page and never becomes “up”. The row says “could not check”, with the reason and the last known answer.',
        ours: true,
      },
    ],
  },
  {
    id: 'deploy',
    name: 'Build and deploy',
    boxes: [
      {
        id: 'github',
        name: 'GitHub',
        what: 'rodrigopimenta10/portfolio-website. Every change is a pull request.',
      },
      {
        id: 'actions',
        name: 'GitHub Actions',
        what: 'Checks every pull request. On merge, deploys the files and the service, signing in to Google Cloud with no stored key.',
      },
      { id: 'registry', name: 'Artifact Registry', what: 'One image for the status service.' },
      {
        id: 'previews',
        name: 'Preview channels',
        what: 'Each pull request gets its own address before it merges.',
      },
    ],
  },
  {
    id: 'key',
    name: 'Key',
    boxes: [
      { id: 'key-ours', name: 'Code', ours: true },
      { id: 'key-managed', name: 'Managed or outside service' },
    ],
    note: 'A dashed arrow is a deploy. A dotted arrow is a name lookup.',
  },
  {
    id: 'checks',
    name: 'Checks',
    boxes: [
      {
        id: 'pull-request-checks',
        name: 'Checks on every pull request',
        what: 'Type-checked, unit-tested, smoke-tested in a browser and held to a Lighthouse floor of 95 in all four categories.',
        ours: true,
      },
    ],
  },
  {
    id: 'infrastructure',
    name: 'Infrastructure',
    boxes: [
      {
        id: 'terraform',
        name: 'Terraform',
        what: 'Declares the hosting, the registry, the service and the keyless sign-in. State is kept in a Cloud Storage bucket.',
        ours: true,
      },
    ],
  },
];

// Drawn in the same units as the boxes, from the edge of one to the edge of another. Every arrow is
// straight or turns at right angles, each long run has a lane of its own in the gap between two
// areas, and no two arrows cross. Moving a box means moving the ends of its arrows here too.
/** x, y and, for a turn that should stay square, a radius of 0. */
type Point = [number, number, number?];

/** A path through the points, with each turn rounded off. */
function route(points: Point[], radius = 8): string {
  const [first, ...rest] = points;
  let d = `M${first![0]} ${first![1]}`;
  rest.forEach(([x, y], index) => {
    const next = rest[index + 1];
    if (!next) {
      d += ` L${x} ${y}`;
      return;
    }
    const [px, py] = index === 0 ? first! : rest[index - 1]!;
    const r = rest[index]![2] ?? radius;
    const before: Point = [x - Math.sign(x - px) * r, y - Math.sign(y - py) * r];
    const after: Point = [x + Math.sign(next[0] - x) * r, y + Math.sign(next[1] - y) * r];
    d += ` L${before[0]} ${before[1]} Q${x} ${y} ${after[0]} ${after[1]}`;
  });
  return d;
}

const arrows: { kind: 'request' | 'lookup' | 'deploy'; points: Point[] }[] = [
  { kind: 'lookup', points: [[171, 140], [171, 163]] }, // browser to DNS
  { kind: 'request', points: [[55, 140], [55, 283]] }, // browser to Hosting, straight down beside DNS
  { kind: 'request', points: [[130, 380], [130, 403]] }, // Hosting to the static files
  { kind: 'request', points: [[246, 332], [278, 332], [278, 92], [309, 92]] }, // Hosting to portfolio-status
  { kind: 'request', points: [[374, 140], [374, 175]] }, // portfolio-status to Sightline
  { kind: 'request', points: [[512, 140], [512, 175]] }, // portfolio-status to Orbital Watch
  { kind: 'request', points: [[650, 140], [650, 175]] }, // portfolio-status to the GitHub API
  { kind: 'request', points: [[894, 124], [894, 147]] }, // GitHub to GitHub Actions
  { kind: 'request', points: [[894, 260], [894, 283]] }, // GitHub Actions to Artifact Registry
  // The two deploys leave GitHub Actions as one line and part in the lane, at a square T: up to
  // the service, down and around to the files.
  { kind: 'deploy', points: [[778, 204], [746, 204, 0], [746, 92], [715, 92]] },
  { kind: 'deploy', points: [[746, 204], [746, 548], [278, 548], [278, 460], [247, 460]] },
];
---

<figure class="site-diagram" aria-label="How this site is served">
  {/* The arrows cannot be heard, so this says what they say. The boxes below are read as they are. */}
  <p class="visually-hidden">
    The visitor’s browser asks Cloudflare DNS where rodrigopimenta.com is, then sends its requests to Firebase Hosting, a
    CDN. Firebase Hosting serves the static files that Astro built and passes /api requests to portfolio-status, one
    service on Cloud Run in us-east4, which asks three public sources: Sightline, Orbital Watch and the GitHub API. On
    the deploy side, every change goes from GitHub to GitHub Actions. GitHub Actions puts the service’s image in
    Artifact Registry, deploys portfolio-status and deploys the static files. Terraform declares the hosting, the
    registry, the service and the keyless sign-in.
  </p>
  <p class="eyebrow scroll-hint">Scroll sideways for all of it <span aria-hidden="true">→</span></p>
  <div class="frame diagram-scroll" tabindex="0" role="group" aria-label="The diagram. It scrolls sideways on a small screen.">
    <div class="board">
      {
        areas.map((area) => (
          <div role="group" aria-labelledby={`site-diagram-${area.id}`}>
            <p class="area" id={`site-diagram-${area.id}`} data-area={area.id}>
              {area.name}
            </p>
            <ul>
              {area.boxes.map((box) => (
                <li class:list={['box', { ours: box.ours, 'name-only': !box.what }]} data-box={box.id}>
                  <strong>{box.name}</strong>
                  {box.what && <span>{box.what}</span>}
                </li>
              ))}
            </ul>
            {area.note && <p class="note">{area.note}</p>}
          </div>
        ))
      }
      <svg class="arrows" viewBox="0 0 1024 742" aria-hidden="true">
        <defs>
          <marker id="site-diagram-tip" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path class="tip" d="M0 0 L10 5 L0 10 z"></path>
          </marker>
        </defs>
        {arrows.map((arrow) => <path class:list={['arrow', arrow.kind]} d={route(arrow.points)} marker-end="url(#site-diagram-tip)" />)}
      </svg>
    </div>
  </div>
  <figcaption>
    {site.hosting.live ? 'How a request is served.' : 'How a request will be served once this is deployed.'}
    <slot />
  </figcaption>
</figure>

<style>
  /* A container, so the hint below can ask whether the board fits, wherever the figure is put.
     It also means the board can never widen the page: only the frame scrolls. */
  .site-diagram {
    container-type: inline-size;
  }

  .scroll-hint {
    margin-bottom: var(--space-2);
  }

  /* The board (64rem) plus the frame's padding and border. Narrower than that, it scrolls. */
  @container (max-width: 66.1rem) {
    .scroll-hint {
      display: block;
      text-transform: none;
      letter-spacing: 0;
    }
  }

  /* The board is drawn on a grid of 1024 by 742 units, and everything on it is placed in those
     units. A unit is a pixel at the usual text size and grows with the reader's. */
  .board {
    --unit: 0.0625rem;
    position: relative;
    width: calc(1024 * var(--unit));
    height: calc(742 * var(--unit));
    margin-inline: auto;
    font-size: 0.78125rem;
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .area,
  .box,
  .note {
    position: absolute;
    left: calc(var(--x) * var(--unit));
    top: calc(var(--y) * var(--unit));
    width: calc(var(--w) * var(--unit));
  }

  .area,
  .box {
    height: calc(var(--h) * var(--unit));
  }

  /* An area is its dashed outline and its name in the corner. */
  .area {
    padding: 0.75rem 0.8125rem;
    border: 1px dashed var(--rule-strong);
    border-radius: 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .box {
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
    padding: 0.5625rem 0.75rem;
    border: 1.5px solid var(--rule-strong);
    border-radius: 0.625rem;
    background: var(--paper);
  }

  .box strong {
    font-size: 0.875rem;
    line-height: 1.25;
    color: var(--ink);
  }

  .box.ours {
    border-color: var(--accent-2);
    background: color-mix(in srgb, var(--accent-2) 11%, var(--paper));
  }

  .box.name-only {
    justify-content: center;
  }

  .arrows {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .arrow {
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 1.5;
  }

  .arrow.deploy {
    stroke-dasharray: 6 4;
  }

  .arrow.lookup {
    stroke-dasharray: 2 4;
  }

  .tip {
    fill: var(--ink-soft);
  }

  /* Where each piece sits: x and y of its top left corner, then width and height, in board units.
     The gaps between areas are 36 wide, and the long arrows run down the middle of them. */
  [data-area='edge'] { --x: 0; --y: 0; --w: 260; --h: 530; }
  [data-area='request'] { --x: 296; --y: 0; --w: 432; --h: 530; }
  [data-area='deploy'] { --x: 764; --y: 0; --w: 260; --h: 530; }
  [data-area='key'] { --x: 0; --y: 566; --w: 260; --h: 176; }
  [data-area='checks'] { --x: 296; --y: 566; --w: 432; --h: 176; }
  [data-area='infrastructure'] { --x: 764; --y: 566; --w: 260; --h: 176; }

  [data-box='browser'] { --x: 14; --y: 44; --w: 232; --h: 96; }
  [data-box='dns'] { --x: 96; --y: 164; --w: 150; --h: 96; }
  [data-box='hosting'] { --x: 14; --y: 284; --w: 232; --h: 96; }
  [data-box='files'] { --x: 14; --y: 404; --w: 232; --h: 112; }

  [data-box='status'] { --x: 310; --y: 44; --w: 404; --h: 96; }
  [data-box='sightline'] { --x: 310; --y: 176; --w: 128; --h: 96; }
  [data-box='orbital-watch'] { --x: 448; --y: 176; --w: 128; --h: 96; }
  [data-box='github-api'] { --x: 586; --y: 176; --w: 128; --h: 96; }
  [data-box='failed-check'] { --x: 310; --y: 420; --w: 404; --h: 96; }

  [data-box='github'] { --x: 778; --y: 44; --w: 232; --h: 80; }
  [data-box='actions'] { --x: 778; --y: 148; --w: 232; --h: 112; }
  [data-box='registry'] { --x: 778; --y: 284; --w: 232; --h: 64; }
  [data-box='previews'] { --x: 778; --y: 436; --w: 232; --h: 80; }

  [data-box='key-ours'] { --x: 14; --y: 606; --w: 232; --h: 38; }
  [data-box='key-managed'] { --x: 14; --y: 652; --w: 232; --h: 38; }
  .note { --x: 14; --y: 698; --w: 232; }

  [data-box='pull-request-checks'] { --x: 310; --y: 606; --w: 404; --h: 80; }
  [data-box='terraform'] { --x: 778; --y: 606; --w: 232; --h: 112; }
</style>
