---
// Orbital Watch's data path, drawn from the "Architecture" section of its README.
---

<svg class="diagram" viewBox="0 0 800 290" role="img" aria-labelledby="ow-diagram-title ow-diagram-desc">
  <title id="ow-diagram-title">How Orbital Watch gets its data</title>
  <desc id="ow-diagram-desc">
    A scheduled refresher on GitHub Actions is the only thing that calls Celestrak; it commits a
    snapshot to the repository. A Cloudflare Worker on a schedule triggers a Cloudflare Pages build
    every two hours and checks that the previous build produced fresh data. The build reads the
    snapshot, fetches NOAA space weather, computes passes, judges the health of each source and
    writes JSON. The result is static files. The browser reads those files and never calls an
    upstream API.
  </desc>
  <defs>
    <marker id="ow-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path class="arrowhead" d="M0 0 8 4 0 8z"></path>
    </marker>
  </defs>

  <rect class="box" x="10" y="24" width="130" height="52" rx="4"></rect>
  <text class="label" x="22" y="46">Celestrak</text>
  <text class="sub" x="22" y="63">element sets</text>

  <rect class="box" x="180" y="24" width="180" height="52" rx="4"></rect>
  <text class="label" x="192" y="46">snapshot refresher</text>
  <text class="sub" x="192" y="63">GitHub Actions, commits it</text>

  <rect class="box" x="10" y="120" width="130" height="52" rx="4"></rect>
  <text class="label" x="22" y="142">NOAA SWPC</text>
  <text class="sub" x="22" y="159">space weather</text>

  <rect class="box" x="180" y="214" width="180" height="52" rx="4"></rect>
  <text class="label" x="192" y="236">Cloudflare Worker</text>
  <text class="sub" x="192" y="253">every 2 h · dead-man check</text>

  <rect class="box accent" x="410" y="96" width="170" height="100" rx="4"></rect>
  <text class="label" x="422" y="120">build</text>
  <text class="sub" x="422" y="138">Cloudflare Pages</text>
  <text class="sub" x="422" y="156">fetch · compute passes</text>
  <text class="sub" x="422" y="171">judge each source</text>
  <text class="sub" x="422" y="186">write JSON</text>

  <rect class="box" x="630" y="110" width="160" height="72" rx="4"></rect>
  <text class="label" x="642" y="134">static files</text>
  <text class="sub" x="642" y="152">HTML, data/health.json</text>
  <text class="sub" x="642" y="167">and four more JSON files</text>

  <rect class="box" x="650" y="222" width="120" height="52" rx="4"></rect>
  <text class="label" x="662" y="244">browser</text>
  <text class="sub" x="662" y="261">never calls upstream</text>

  <path class="wire" d="M140 50H179" marker-end="url(#ow-arrow)"></path>
  <path class="wire" d="M360 50H470V95" marker-end="url(#ow-arrow)"></path>
  <path class="wire" d="M140 146H409" marker-end="url(#ow-arrow)"></path>
  <path class="wire dashed" d="M360 240H470V197" marker-end="url(#ow-arrow)"></path>
  <path class="wire" d="M580 146H629" marker-end="url(#ow-arrow)"></path>
  <path class="wire" d="M710 182V221" marker-end="url(#ow-arrow)"></path>
</svg>
