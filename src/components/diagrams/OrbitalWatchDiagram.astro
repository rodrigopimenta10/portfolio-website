---
// Orbital Watch's data path, drawn from the "Architecture" section of its README.
---

<svg class="diagram" viewBox="0 0 800 290" role="img" aria-labelledby="ow-diagram-title ow-diagram-desc">
  <title id="ow-diagram-title">How Orbital Watch gets its data</title>
  <desc id="ow-diagram-desc">
    Cloud Scheduler starts one Cloud Run job every ten minutes. The job fetches NOAA space weather
    every run and Celestrak element sets at most once every two hours per group, keeping what it
    fetched and when it last asked in a private Cloud Storage bucket. It computes passes, judges
    the health of each source and publishes one document to a public bucket. The page is static
    files on Firebase Hosting. The browser reads the published document and never calls an
    upstream API. Cloud Monitoring alerts if a run fails or if none succeeds for thirty minutes.
  </desc>
  <defs>
    <marker id="ow-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path class="arrowhead" d="M0 0 8 4 0 8z"></path>
    </marker>
  </defs>

  <rect class="box" x="10" y="24" width="130" height="52" rx="4"></rect>
  <text class="label" x="22" y="46">Celestrak</text>
  <text class="sub" x="22" y="63">element sets</text>

  <rect class="box" x="10" y="120" width="130" height="52" rx="4"></rect>
  <text class="label" x="22" y="142">NOAA SWPC</text>
  <text class="sub" x="22" y="159">space weather</text>

  <rect class="box" x="10" y="214" width="150" height="52" rx="4"></rect>
  <text class="label" x="22" y="236">Cloud Scheduler</text>
  <text class="sub" x="22" y="253">every 10 minutes</text>

  <rect class="box accent" x="210" y="86" width="180" height="120" rx="4"></rect>
  <text class="label" x="222" y="110">job</text>
  <text class="sub" x="222" y="128">Cloud Run</text>
  <text class="sub" x="222" y="146">fetch what is due</text>
  <text class="sub" x="222" y="161">compute passes</text>
  <text class="sub" x="222" y="176">judge each source</text>
  <text class="sub" x="222" y="191">publish one document</text>

  <rect class="box" x="210" y="24" width="180" height="40" rx="4"></rect>
  <text class="sub" x="222" y="49">state: private bucket</text>

  <rect class="box" x="440" y="110" width="150" height="72" rx="4"></rect>
  <text class="label" x="452" y="134">latest.json</text>
  <text class="sub" x="452" y="152">public bucket</text>
  <text class="sub" x="452" y="167">written in one piece</text>

  <rect class="box" x="640" y="120" width="150" height="52" rx="4"></rect>
  <text class="label" x="652" y="142">browser</text>
  <text class="sub" x="652" y="159">never calls upstream</text>

  <rect class="box" x="640" y="24" width="150" height="52" rx="4"></rect>
  <text class="label" x="652" y="46">page</text>
  <text class="sub" x="652" y="63">Firebase Hosting</text>

  <rect class="box" x="440" y="214" width="350" height="52" rx="4"></rect>
  <text class="label" x="452" y="236">Cloud Monitoring</text>
  <text class="sub" x="452" y="253">a run failed · none succeeded for 30 minutes</text>

  <path class="wire" d="M140 50H190V120H209" marker-end="url(#ow-arrow)"></path>
  <path class="wire" d="M140 146H209" marker-end="url(#ow-arrow)"></path>
  <path class="wire dashed" d="M160 240H300V207" marker-end="url(#ow-arrow)"></path>
  <path class="wire" d="M300 86V65" marker-start="url(#ow-arrow)" marker-end="url(#ow-arrow)"></path>
  <path class="wire" d="M390 146H439" marker-end="url(#ow-arrow)"></path>
  <path class="wire" d="M590 146H639" marker-start="url(#ow-arrow)"></path>
  <path class="wire" d="M715 76V119" marker-end="url(#ow-arrow)"></path>
  <path class="wire dashed" d="M345 207V240H439" marker-end="url(#ow-arrow)"></path>
</svg>
