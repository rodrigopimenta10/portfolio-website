  <rect class="box ghost" x="450" y="406" width="340" height="38" rx="4"></rect>
  <text class="label" x="462" y="430">Redis</text>
  <text class="sub" x="506" y="430">shared limits and answers · off since Nov 2026</text>

  <rect class="box ghost" x="10" y="330" width="250" height="68" rx="4"></rect>
  <text class="label" x="24" y="354">All of it in Terraform</text>
  <text class="sub" x="24" y="372">applied from GitHub Actions,</text>
  <text class="sub" x="24" y="387">with no stored keys</text>
</svg>
