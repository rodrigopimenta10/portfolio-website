---
// The last thing on a page: two or three ways on, so no page is a dead end. The first link is the
// next chapter of the story (the tabs, in order); the others are the chapter after and the way out.
interface Props {
  links: { label: string; text: string; href: string }[];
}

const { links } = Astro.props;
---

<nav class="onward" aria-label="Where to go next">
  {
    links.map((link) => (
      <a href={link.href}>
        <span class="eyebrow">{link.label}</span>
        <span class="text">
          {link.text} <span aria-hidden="true">→</span>
        </span>
      </a>
    ))
  }
</nav>

<style>
  .onward {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17.5rem, 100%), 1fr));
    gap: var(--space-4);
    padding-block: var(--space-7) 0;
    border-top: 1px solid var(--rule);
  }

  a {
    display: grid;
    gap: 0.375rem;
    align-content: start;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-raised);
    text-decoration: none;
    transition:
      border-color 140ms ease,
      transform 140ms ease;
  }

  a:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .text {
    font-size: 1.125rem;
    line-height: 1.3;
    font-weight: 600;
    color: var(--accent);
  }
</style>
