---
import { nav, site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  path: string;
}

const { path } = Astro.props;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="site-name" href="/" aria-current={path === '/' ? 'page' : undefined}>
      <span class="mark" aria-hidden="true">RP</span>
      <span>{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} title={'title' in item ? item.title : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid transparent;
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'name toggle' 'nav nav';
    align-items: center;
    gap: var(--space-1) var(--space-5);
    padding-block: var(--space-3);
  }

  .site-name {
    grid-area: name;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  /* The same mark as the tab icon: initials on the accent. */
  .mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.6rem;
    background: var(--grad);
    color: var(--accent-ink);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  nav {
    grid-area: nav;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    /* Four links fit one line at 360 px. */
    gap: 0 var(--space-4);
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink-soft);
    border-radius: 999px;
    transition:
      color 120ms ease,
      background-color 120ms ease;
  }

  /* On a phone the four links share one line, down to 360 px wide. */
  @media (max-width: 45.99rem) {
    nav a {
      font-size: 0.875rem;
    }
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }

  :global(.theme-toggle) {
    grid-area: toggle;
  }

  @media (min-width: 46rem) {
    /* On wider screens the header stays at the top while the page scrolls under it. */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 20;
      background: var(--header-bg);
      -webkit-backdrop-filter: saturate(1.4) blur(14px);
      backdrop-filter: saturate(1.4) blur(14px);
      border-bottom-color: var(--rule);
    }

    .bar {
      grid-template-columns: 1fr auto auto;
      grid-template-areas: 'name nav toggle';
      padding-block: var(--space-3);
    }

    ul {
      gap: var(--space-1);
    }

    nav a {
      min-height: 2.5rem;
      padding: 0 var(--space-4);
    }

    nav a:hover {
      background: var(--paper-sunk);
    }

    nav a[aria-current='page'] {
      background: var(--paper-sunk);
    }
  }
</style>
