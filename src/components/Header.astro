---
import { Image } from 'astro:assets';
import portrait from '../assets/rodrigo.jpg';
import { nav, site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  path: string;
}

const { path } = Astro.props;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="site-name" href="/" aria-current={path === '/' ? 'page' : undefined}>
      <Image class="portrait" src={portrait} alt="" width={36} height={36} densities={[1, 2, 3]} loading="eager" />
      <span>{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
    {/* One click to the document a recruiter came for. On a phone the "(PDF)" is dropped to save room. */}
    <a class="resume" href={site.resumePdf}>Resume<span class="pdf"> (PDF)</span></a>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto auto;
    grid-template-areas: 'name toggle resume' 'nav nav nav';
    align-items: center;
    gap: 0 var(--space-2);
    padding-block: var(--space-2) 0;
  }

  .site-name {
    grid-area: name;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 3rem;
    min-width: 0;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .portrait {
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    object-fit: cover;
    background: var(--paper-sunk);
  }

  nav {
    grid-area: nav;
  }

  ul {
    display: flex;
    /* Four links share one line, down to 360 px wide. */
    justify-content: space-between;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-2);
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--ink-soft);
    /* The current page is marked by a rule under its link, drawn inside the link's own box. */
    box-shadow: inset 0 -2px 0 transparent;
    transition: color 120ms ease;
  }

  li:first-child a {
    padding-left: 0;
  }

  li:last-child a {
    padding-right: 0;
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  :global(.theme-toggle) {
    grid-area: toggle;
  }

  .resume {
    grid-area: resume;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-3);
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 140ms ease,
      color 140ms ease;
  }

  .resume:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .pdf {
    display: none;
  }

  @media (min-width: 46rem) {
    /* On wider screens the header stays at the top while the page scrolls under it. */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 20;
      background: var(--header-bg);
      -webkit-backdrop-filter: saturate(1.4) blur(14px);
      backdrop-filter: saturate(1.4) blur(14px);
    }

    .bar {
      grid-template-columns: 1fr auto auto auto;
      grid-template-areas: 'name nav toggle resume';
      gap: 0 var(--space-3);
      padding-block: var(--space-2);
    }

    ul {
      gap: var(--space-1);
    }

    nav a {
      padding-inline: var(--space-3);
      font-size: 0.9375rem;
    }

    li:first-child a {
      padding-left: var(--space-3);
    }

    li:last-child a {
      padding-right: var(--space-3);
    }

    .resume {
      padding-inline: var(--space-4);
    }

    .pdf {
      display: inline;
      white-space: pre;
    }
  }
</style>
