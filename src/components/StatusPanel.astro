---
// "Everything I run, right now." The rows are in the HTML from the start, in a "checking" state,
// so the panel has its final size before any data arrives. The script fills them from /api/status
// after the page has painted, and says so plainly when the service is slow or does not answer.
//
// The section's id is `status`: the line on the home page (StatusLine.astro) links to it.
import { DEMO_BUTTON } from '../lib/status/demo';
import { SYSTEMS } from '../lib/status/types';
---

<section class="status surface" id="status" data-status-panel aria-labelledby="status-title">
  <header class="head">
    <h2 id="status-title">Everything I run, right now</h2>
    <p class="summary mono" data-status-summary role="status">Checking…</p>
  </header>

  <ul class="rows">
    {
      SYSTEMS.map((system) => (
        <li class="row" data-system={system.id} data-state="loading">
          <span class="glyph" aria-hidden="true" />
          <div class="body">
            <p class="top">
              <a class="name" href={system.url}>
                {system.name}
              </a>
              <span class="state mono" data-state-label>
                checking
              </span>
            </p>
            <p class="fact" data-fact>
              <span class="skeleton" aria-hidden="true" />
            </p>
            <p class="meta mono" data-meta />
          </div>
        </li>
      ))
    }
  </ul>

  <footer class="foot" data-status-foot>
    <div class="says">
      <noscript><p>This panel needs JavaScript. Each name above links to the system itself.</p></noscript>
      <p data-status-about>
        Checked by one small service after the page paints. When a check fails, the panel says so and does not guess.
      </p>
      {/* Speaks up when there is something to say: a slow answer, no answer, or the demonstration. */}
      <p data-status-note role="status"></p>
    </div>
    <button class="button retry" type="button" data-status-retry hidden>Try again</button>
    {/* One check is drawn as failed, on this screen only, so a visitor can see what the panel does
        when a real one fails. The button's words change with what it does next, so it carries no
        pressed state. Disabled until there is a reading with something up to fail. */}
    <button class="button quiet demo" type="button" data-status-demo disabled>{DEMO_BUTTON.start}</button>
  </footer>
</section>

<script>
  import '../scripts/status-panel';
</script>

<style>
  .status {
    overflow: hidden;
    scroll-margin-top: var(--space-4);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--rule);
  }

  .head h2 {
    font-size: var(--text-lg);
    letter-spacing: -0.015em;
  }

  .summary {
    color: var(--ink-soft);
  }

  /* Side by side where there is room, stacked on a phone. Each row draws its own top and left rule
     and the list cuts off the outer ones, so the rules are right however the rows wrap. */
  .rows {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    overflow: hidden;
  }

  .row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    margin: -1px 0 0 -1px;
    padding: var(--space-4) var(--space-5);
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
    color: var(--state-unknown);
  }

  .row[data-state='up'] {
    color: var(--state-up);
  }

  /* "Could not check" is a warning, not a verdict: it shares its colour with "degraded" and differs in shape. */
  .row[data-state='degraded'],
  .row[data-state='unknown'] {
    color: var(--state-degraded);
  }

  .row[data-state='down'] {
    color: var(--state-down);
  }

  /* Each state has its own shape as well as its own colour. */
  .glyph {
    width: 0.7rem;
    height: 0.7rem;
    margin-top: 0.55rem;
    background: currentColor;
    border-radius: 50%;
  }

  .row[data-state='degraded'] .glyph {
    border-radius: 0;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  .row[data-state='down'] .glyph {
    border-radius: 1px;
  }

  .row[data-state='unknown'] .glyph,
  .row[data-state='loading'] .glyph {
    background: transparent;
    border: 1.5px dashed currentColor;
  }

  /* The waiting marks stop by themselves after a few seconds, answer or no answer. */
  .row[data-state='loading'] .glyph {
    border-style: solid;
    border-right-color: transparent;
    animation: spin 0.9s linear 5;
  }

  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }

  .body {
    min-width: 0;
    color: var(--ink);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 var(--space-4);
  }

  .name {
    position: relative;
    font-weight: 600;
    line-height: 1.75rem;
    text-decoration-color: var(--rule-strong);
  }

  /* The name is one line of text. Its tap area reaches past it, into the row's own padding. */
  .name::after {
    content: '';
    position: absolute;
    inset: -0.5rem -0.375rem;
  }

  .name:hover {
    text-decoration-color: var(--accent);
  }

  .state {
    font-size: var(--text-xs);
    font-weight: 500;
    white-space: nowrap;
    color: var(--state-unknown);
  }

  .row[data-state='up'] .state {
    color: var(--state-up);
  }

  .row[data-state='degraded'] .state,
  .row[data-state='unknown'] .state {
    color: var(--state-degraded);
  }

  .row[data-state='down'] .state {
    color: var(--state-down);
  }

  .fact {
    min-height: 1.55em;
    font-size: 0.9375rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  /* A real fact usually runs to two lines. A waiting row keeps room for that, so less moves when it arrives. */
  .row[data-state='loading'] .fact {
    min-height: 3.1em;
  }

  .fact :global(.reason) {
    display: block;
    color: var(--ink-soft);
  }

  .meta {
    margin-top: 0.15rem;
    min-height: 1.3rem;
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }

  .skeleton {
    display: inline-block;
    width: min(18rem, 80%);
    height: 0.7em;
    border-radius: 999px;
    background: var(--paper-sunk);
    animation: breathe 1.4s ease-in-out 3 alternate;
  }

  @keyframes breathe {
    from {
      opacity: 0.55;
    }
    to {
      opacity: 1;
    }
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
    border-top: 1px solid var(--rule);
    transition: background-color 160ms ease;
  }

  .foot[data-tone='failed'] {
    background: var(--wash-down);
  }

  .foot[data-tone='waiting'],
  .foot[data-tone='demo'],
  .foot[data-tone='recorded'] {
    background: var(--wash-degraded);
  }

  /* The small print and the note share one cell. The small print keeps its room while a note is
     shown in its place, so the panel does not change size when it speaks up. */
  .says {
    flex: 1 1 12.5rem;
    display: grid;
    min-width: 0;
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .says > p {
    grid-area: 2 / 1;
  }

  .foot[data-tone] [data-status-about] {
    visibility: hidden;
  }

  .foot[data-tone] .says {
    color: var(--ink);
  }

  .foot .button {
    flex: none;
    font-size: var(--text-sm);
  }

  /* The shared button sets its own display, which would otherwise show a hidden one. */
  .foot .button[hidden] {
    display: none;
  }

  .demo:disabled {
    color: var(--ink-soft);
    cursor: default;
  }

  .demo:disabled:hover {
    border-color: var(--rule-strong);
    transform: none;
  }
</style>
