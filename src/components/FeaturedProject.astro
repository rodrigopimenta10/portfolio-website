---
// A large card for the home page: screenshot, one sentence, a few facts, and the doors.
import { Image } from 'astro:assets';
import type { PersonalProject } from '../lib/projects';

interface Props {
  project: PersonalProject;
  index: number;
}

const { project, index } = Astro.props;
const { data } = project;
const href = `/projects/${project.id}`;
---

<article class:list={['card', 'surface', { lead: index === 0 }]}>
  <div class="shot">
    <Image
      src={data.screenshot.src}
      alt=""
      widths={[480, 720, 960, 1440, 2160]}
      sizes={index === 0 ? '(min-width: 60rem) 44rem, calc(100vw - 2.25rem)' : '(min-width: 44rem) 36rem, calc(100vw - 2.25rem)'}
      loading={index === 0 ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>
  <div class="text">
    <p class="eyebrow">
      <span class="num">{String(index + 1).padStart(2, '0')}</span>
      {data.live && <span class="live">Live</span>}
    </p>
    <h3><a class="stretch" href={href}>{data.title}</a></h3>
    <p class="summary">{data.summary}</p>
    <ul class="facts">
      {data.facts.map((fact) => <li>{fact}</li>)}
    </ul>
    <p class="doors">
      <span class="go" aria-hidden="true">About {data.title} <span>→</span></span>
      {data.live && <a href={data.live}>Live site</a>}
      <a href={data.code}>Code</a>
    </p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    align-content: start;
    overflow: hidden;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: var(--rule-strong);
    box-shadow: var(--shadow-lift);
  }

  .shot {
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
    background: var(--paper-sunk);
    aspect-ratio: 16 / 10;
  }

  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform 400ms ease;
  }

  .card:hover .shot :global(img) {
    transform: scale(1.025);
  }

  .text {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-5) var(--space-5) var(--space-5);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent);
  }

  .live::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: currentColor;
  }

  h3 {
    font-size: var(--text-xl);
  }

  h3 a {
    text-decoration: none;
  }

  /* The whole card is the link: the title's link is stretched over it. */
  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .summary {
    color: var(--ink-soft);
  }

  .facts {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-1);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .facts li {
    position: relative;
    padding-left: 1.4rem;
  }

  .facts li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.42em;
    width: 0.7rem;
    height: 0.38rem;
    border-left: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
    transform: rotate(-45deg);
  }

  .doors {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-5);
    margin-top: var(--space-2);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .go {
    color: var(--accent);
  }

  .go span {
    display: inline-block;
    transition: transform 160ms ease;
  }

  .card:hover .go span {
    transform: translateX(4px);
  }

  /* The other two links sit above the stretched one, so they still go where they say. */
  .doors a {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--ink-soft);
    text-decoration-color: var(--rule-strong);
  }

  .doors a:hover {
    color: var(--ink);
    text-decoration-color: var(--accent);
  }

  @media (min-width: 44rem) {
    /* The first project runs the full width. */
    .card.lead {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 60rem) {
    .card.lead {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-content: stretch;
    }

    .card.lead .shot {
      aspect-ratio: auto;
      min-height: 100%;
      border-bottom: 0;
      border-right: 1px solid var(--rule);
    }

    .card.lead .text {
      padding: var(--space-6);
      align-content: center;
    }

    .card.lead h3 {
      font-size: var(--text-2xl);
    }
  }
</style>
