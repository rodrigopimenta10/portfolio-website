---
// Light and dark follow the system until the visitor presses this. A choice that matches the
// system setting is forgotten again, so the site goes back to following the system.
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch between light and dark theme">
  <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
    <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor"></path>
  </svg>
  <span class="visually-hidden" data-theme-label>Theme</span>
</button>

<script>
  const root = document.documentElement;
  const system = window.matchMedia('(prefers-color-scheme: dark)');
  const current = (): 'light' | 'dark' => {
    const chosen = root.dataset['theme'];
    return chosen === 'light' || chosen === 'dark' ? chosen : system.matches ? 'dark' : 'light';
  };

  function label(button: HTMLElement) {
    const next = current() === 'dark' ? 'light' : 'dark';
    button.setAttribute('aria-label', `Switch to ${next} theme`);
    const text = button.querySelector('[data-theme-label]');
    if (text) text.textContent = next === 'dark' ? 'Dark' : 'Light';
  }

  for (const button of document.querySelectorAll<HTMLElement>('[data-theme-toggle]')) {
    label(button);
    system.addEventListener('change', () => label(button));
    button.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      const systemTheme = system.matches ? 'dark' : 'light';
      try {
        if (next === systemTheme) {
          delete root.dataset['theme'];
          localStorage.removeItem('theme');
        } else {
          root.dataset['theme'] = next;
          localStorage.setItem('theme', next);
        }
      } catch {
        root.dataset['theme'] = next;
      }
      label(button);
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    min-width: 2.75rem;
    justify-content: center;
    padding: 0 var(--space-3);
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper-raised);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-soft);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
  }
</style>
